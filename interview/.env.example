# One Gemini key powers all active AI features. Never commit your .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RESEARCH_MODEL=gemini-3.5-flash
INTERVIEW_PORT=8766
# Set 0 to disable company web research; questions/audio/text still work.
INTERVIEW_RESEARCH_ENABLED=1

# Continuous voice interview uses a Live-capable model.
GEMINI_LIVE_MODEL=gemini-3.8-live
